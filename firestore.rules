rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validStatus(status) {
      return status in ["AVAILABLE", "WORN", "IN_LAUNDRY"];
    }

    function validCategory(category) {
      return category in [
        "top",
        "bottom",
        "outerwear",
        "footwear",
        "one_piece",
        "accessory",
        "shoes" // legacy alias kept for backwards compatibility
      ];
    }

    function validWearCount(count) {
      return count is number && count >= 0;
    }

    function validColorSource(source) {
      return source in ["ai", "user", "pixel"];
    }

    function validOptionalString(value) {
      return value == null || value is string;
    }

    function validOptionalNumber(value) {
      return value == null || value is number;
    }

    function validOptionalBool(value) {
      return value == null || value is bool;
    }

    function validOptionalMap(value) {
      return value == null || value is map;
    }

    function validCrop(value) {
      return value == null || (
        value is map
        && value.x is number
        && value.y is number
        && value.w is number
        && value.h is number
        && value.source == "ai"
      );
    }

    function validPhotosMap(value) {
      return value is map
        && (!("primaryUrl" in value) || validOptionalString(value.primaryUrl))
        && (!("croppedUrl" in value) || validOptionalString(value.croppedUrl))
        && (!("thumbUrl" in value) || validOptionalString(value.thumbUrl))
        && (!("cleanedUrl" in value) || validOptionalString(value.cleanedUrl))
        && (!("cleanedPhotoUrl" in value) || validOptionalString(value.cleanedPhotoUrl))
        && (!("cleanedThumbUrl" in value) || validOptionalString(value.cleanedThumbUrl))
        && (!("cleanedSource" in value) || value.cleanedSource in ["placeholder", "onnx", "vision"])
        && (!("cleanedFromHash" in value) || validOptionalString(value.cleanedFromHash))
        && (!("urls" in value) || value.urls is list);
    }

    function noForeignUidField(data, uid) {
      return !("uid" in data) || data.uid == uid;
    }

    function validItemCreate(data, uid) {
      return data is map
        && data.keys().hasAll(["status", "category", "wearCountSinceWash"])
        && validStatus(data.status)
        && validCategory(data.category)
        && validWearCount(data.wearCountSinceWash)
        && noForeignUidField(data, uid);
    }

    function validItemUpdate(data, uid) {
      let changed = data.diff(resource.data).affectedKeys();
      return data is map
        && (!changed.hasAny(["status"]) || validStatus(data.status))
        && (!changed.hasAny(["category"]) || validCategory(data.category))
        && (!changed.hasAny(["subCategory"]) || validOptionalString(data.subCategory))
        && (!changed.hasAny(["brand"]) || validOptionalString(data.brand))
        && (!changed.hasAny(["name"]) || validOptionalString(data.name))
        && (!changed.hasAny(["wearCountSinceWash"]) || validWearCount(data.wearCountSinceWash))
        && (!changed.hasAny(["colorSource"]) || validColorSource(data.colorSource))
        && (!changed.hasAny(["colorUpdatedAt"]) || data.colorUpdatedAt is number)
        && (!changed.hasAny(["colorLabel"]) || validOptionalString(data.colorLabel))
        && (!changed.hasAny(["primaryColor"]) || validOptionalString(data.primaryColor))
        && (!changed.hasAny(["colors"]) || data.colors is list)
        && (!changed.hasAny(["aiColorLabel"]) || validOptionalString(data.aiColorLabel))
        && (!changed.hasAny(["aiColors"]) || data.aiColors is list)
        && (!changed.hasAny(["pixelColors"]) || data.pixelColors is list)
        && (!changed.hasAny(["pixelColorHex"]) || validOptionalString(data.pixelColorHex))
        && (!changed.hasAny(["colorConfidence"]) || validOptionalNumber(data.colorConfidence))
        && (!changed.hasAny(["colorNeedsReview"]) || validOptionalBool(data.colorNeedsReview))
        && (!changed.hasAny(["crop"]) || validCrop(data.crop))
        && (!changed.hasAny(["cleanedUpdatedAt"]) || data.cleanedUpdatedAt is number)
        && (!changed.hasAny(["priceAmount"]) || validOptionalNumber(data.priceAmount))
        && (!changed.hasAny(["priceCurrency"]) || validOptionalString(data.priceCurrency))
        && (!changed.hasAny(["purchaseDate"]) || validOptionalString(data.purchaseDate))
        && (!changed.hasAny(["size"]) || validOptionalString(data.size))
        && (!changed.hasAny(["notes"]) || validOptionalString(data.notes))
        && (!changed.hasAny(["careTags"]) || data.careTags == null || data.careTags is list)
        && (!changed.hasAny(["lastWashedAt"]) || validOptionalNumber(data.lastWashedAt))
        && (!changed.hasAny(["lastWornDate"]) || validOptionalString(data.lastWornDate))
        && (!changed.hasAny(["lastWashedDate"]) || validOptionalString(data.lastWashedDate))
        && (!changed.hasAny(["pattern"]) || validOptionalString(data.pattern))
        && (!changed.hasAny(["material"]) || validOptionalString(data.material))
        && (!changed.hasAny(["occasionTags"]) || data.occasionTags == null || data.occasionTags is list)
        && (!changed.hasAny(["seasonTags"]) || data.seasonTags == null || data.seasonTags is list)
        && (!changed.hasAny(["fit"]) || validOptionalString(data.fit))
        && (!changed.hasAny(["rise"]) || validOptionalString(data.rise))
        && (!changed.hasAny(["legShape"]) || validOptionalString(data.legShape))
        && (!changed.hasAny(["warmthPreference"]) || validOptionalNumber(data.warmthPreference))
        && (!changed.hasAny(["photoUrl"]) || validOptionalString(data.photoUrl))
        && (!changed.hasAny(["photoUri"]) || validOptionalString(data.photoUri))
        && (!changed.hasAny(["createdAt"]) || validOptionalNumber(data.createdAt))
        && (!changed.hasAny(["isDraft"]) || validOptionalBool(data.isDraft))
        && (!changed.hasAny(["wearSlot"]) || validOptionalString(data.wearSlot))
        && (!changed.hasAny(["brandConfidence"]) || validOptionalNumber(data.brandConfidence))
        && (!changed.hasAny(["brandEvidence"]) || validOptionalString(data.brandEvidence))
        && (!changed.hasAny(["brandCandidates"]) || data.brandCandidates == null || data.brandCandidates is list)
        && (!changed.hasAny(["brandSource"]) || validOptionalString(data.brandSource))
        && (!changed.hasAny(["brandUpdatedAt"]) || validOptionalNumber(data.brandUpdatedAt))
        && (!changed.hasAny(["ingestionStatus"]) || validOptionalString(data.ingestionStatus))
        && (!changed.hasAny(["ingestion"]) || validOptionalMap(data.ingestion))
        && (!changed.hasAny(["ingestionSource"]) || validOptionalMap(data.ingestionSource))
        && (!changed.hasAny(["cleanedFromHash"]) || validOptionalString(data.cleanedFromHash))
        && (!changed.hasAny(["updatedAt"]) || data.updatedAt is number)
        && (!changed.hasAny(["photos"]) || validPhotosMap(data.photos))
        && (!changed.hasAny(["uid"]) || data.uid == uid)
        && noForeignUidField(data, uid);
    }

    // Firestore rules do not support full list iteration, so we enforce list type and ownership fields.
    function validOutfitCreate(data, uid) {
      return data is map
        && data.keys().hasAll(["itemIds", "planned"])
        && data.itemIds is list
        && data.planned is bool
        && noForeignUidField(data, uid);
    }

    function validOutfitUpdate(data, uid) {
      let changed = data.diff(resource.data).affectedKeys();
      return data is map
        && (!changed.hasAny(["itemIds"]) || data.itemIds is list)
        && (!changed.hasAny(["planned"]) || data.planned is bool)
        && (!changed.hasAny(["uid"]) || data.uid == uid)
        && noForeignUidField(data, uid);
    }

    function validThreadDoc(data, uid) {
      return data is map && noForeignUidField(data, uid);
    }

    function validMessageDoc(data, uid) {
      return data is map
        && data.keys().hasAll(["role", "text"])
        && data.role in ["user", "assistant"]
        && data.text is string
        && noForeignUidField(data, uid);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /items/{itemId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validItemCreate(request.resource.data, uid);
        allow update: if isOwner(uid) && validItemUpdate(request.resource.data, uid);
        allow delete: if isOwner(uid);
      }

      match /outfits/{dateKey} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validOutfitCreate(request.resource.data, uid);
        allow update: if isOwner(uid) && validOutfitUpdate(request.resource.data, uid);
        allow delete: if isOwner(uid);
      }

      match /threads/{threadId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validThreadDoc(request.resource.data, uid);
        allow delete: if isOwner(uid);

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && validMessageDoc(request.resource.data, uid);
          allow delete: if isOwner(uid);
        }
      }

      match /ai/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
