{
  "name": "aura",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "precommit": "npm test && cd functions && npm test",
    "aura:eval": "node scripts/aura-intelligence-eval.cjs",
    "check:eas-env": "node scripts/check-eas-public-env.cjs"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "^5.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@six33/react-native-bg-removal": "^1.3.4",
    "burnt": "^0.13.0",
    "expo": "~54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.21",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-vision-bg": "file:modules/expo-vision-bg",
    "firebase": "^12.9.0",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "8.5.15",
    "uuid": "11.1.1",
    "xml2js": "0.6.2",
    "@expo/plist": "0.7.0"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "modules"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-voice/voice",
          "@six33/react-native-bg-removal",
          "expo-vision-bg"
        ]
      }
    }
  }
}
