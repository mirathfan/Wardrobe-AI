# Optional override for canonical and social metadata URLs.
# Vercel deployment URLs are detected automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://aura.example

# Public, non-secret support contact shown on policy and support pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@aura.example

# Google Sheets beta signup integration.
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_RANGE=Sheet1!A:B
GOOGLE_SERVICE_ACCOUNT_EMAIL=aura-beta-signups@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-key\n-----END PRIVATE KEY-----\n"
